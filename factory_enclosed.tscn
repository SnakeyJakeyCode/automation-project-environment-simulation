[sub_resource type="GDScript" id="Script_CellGate"]
script/source = "extends Node3D

var gate_closed: bool = true
var gate_moving: bool = false
var latest_status: String = \"Ready to run\"
@onready var slider: Node3D = $Slider
@onready var robot: Node = $\"../../RobotSystem\"
@onready var player: Node3D = $\"../../Player\"
@onready var status_label: Label = $\"../../CellHUD/Status\"

func _ready() -> void:
	robot.connect(\"status_changed\", _on_robot_status)

func _process(_delta: float) -> void:
	var state: String = \"CLOSED\"
	if gate_moving:
		state = \"MOVING\"
	elif not gate_closed:
		state = \"OPEN\"
	if bool(robot.get(\"animation_running\")):
		state += \" / LOCKED\"
	status_label.text = \"ROBOT CELL  |  Gate: \" + state + \"\\nG: slide loading gate  |  Use your existing demo-start control\\n\" + latest_status

func _on_robot_status(message: String) -> void:
	latest_status = message

func player_inside() -> bool:
	var p: Vector3 = get_parent().to_local(player.global_position)
	return p.x > -11.5 and p.x < 13.5 and p.z > -5.5 and p.z < 2.5

func cycle_block_reason() -> String:
	if gate_moving or not gate_closed:
		return \"Start blocked: close the loading gate first (G).\"
	if player_inside():
		return \"Start blocked: leave the enclosure, then close the gate.\"
	return \"\"

func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed and not event.echo:
		if event.physical_keycode == KEY_G:
			get_viewport().set_input_as_handled()
			toggle_gate()

func toggle_gate() -> void:
	if gate_moving:
		return
	if bool(robot.get(\"animation_running\")):
		latest_status = \"Gate locked: wait for the robot cycle to finish.\"
		return
	# Keep the exit open if the player is still in the cell or doorway.
	var p: Vector3 = to_local(player.global_position)
	if not gate_closed and (player_inside() or (absf(p.x) < 1.4 and absf(p.z) < 0.65)):
		latest_status = \"Leave the enclosure and doorway before closing the gate.\"
		return
	var opening: bool = gate_closed
	gate_closed = false
	gate_moving = true
	var slide: Tween = create_tween()
	slide.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	slide.tween_property(slider, \"position:x\", 2.2 if opening else 0.0, 1.2)
	await slide.finished
	gate_closed = not opening
	gate_moving = false
	latest_status = \"Gate open: load the sheet, then leave the cell.\" if opening else \"Gate closed: ready to run.\"
"

[sub_resource type="Shader" id="Shader_FenceGrid"]
code = "shader_type spatial;
render_mode cull_disabled;
uniform vec2 grid_count = vec2(12.0, 14.0);
void fragment() {
    vec2 cell = fract(UV * grid_count);
    vec2 edge = min(cell, vec2(1.0) - cell);
    if (min(edge.x, edge.y) > 0.035) { discard; }
    ALBEDO = vec3(0.15, 0.19, 0.21);
    METALLIC = 0.5;
    ROUGHNESS = 0.7;
}
"

