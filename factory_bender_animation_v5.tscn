[sub_resource type="GDScript" id="Script_BendableSheet"]
script/source = "extends Node3D

# Rounded, prescribed flange deformation. Local origin is the suction grip.
var bend_degrees: float = 0.0
var steel: StandardMaterial3D
@onready var sheet_mesh: MeshInstance3D = $PartMesh

func _ready() -> void:
	sheet_mesh.position = Vector3.ZERO
	steel = StandardMaterial3D.new()
	steel.albedo_color = Color(0.56, 0.61, 0.66)
	steel.metallic = 0.65
	steel.roughness = 0.45
	steel.cull_mode = BaseMaterial3D.CULL_DISABLED
	set_bend(0.0)

func set_bend(degrees: float) -> void:
	bend_degrees = clampf(degrees, 0.0, 90.0)
	if not is_instance_valid(sheet_mesh):
		return
	var surface: SurfaceTool = SurfaceTool.new()
	surface.begin(Mesh.PRIMITIVE_TRIANGLES)
	surface.set_material(steel)
	var sections: Array = []
	# Dense sampling around the bend; one continuous surface, not swapped models.
	for i: int in range(41):
		var z: float = -0.65 + float(i) * 0.02
		var center: Vector3 = Vector3(0.0, 0.0, z)
		var normal: Vector3 = Vector3.UP
		var distance: float = -0.5 - z
		var angle: float = deg_to_rad(bend_degrees)
		if distance > 0.0 and angle > 0.0001:
			var arc_length: float = 0.05
			var radius: float = arc_length / angle
			var theta: float = minf(distance / arc_length, 1.0) * angle
			center.y = radius * (1.0 - cos(theta))
			center.z = -0.5 - radius * sin(theta)
			if distance > arc_length:
				center.y += (distance - arc_length) * sin(angle)
				center.z -= (distance - arc_length) * cos(angle)
			normal = Vector3(0.0, cos(theta), sin(theta))
		sections.append([
			center + Vector3(-0.6, 0, 0) + normal * 0.025,
			center + Vector3(0.6, 0, 0) + normal * 0.025,
			center + Vector3(-0.6, 0, 0) - normal * 0.025,
			center + Vector3(0.6, 0, 0) - normal * 0.025
		])
	for i: int in range(sections.size() - 1):
		var a: Array = sections[i]
		var b: Array = sections[i + 1]
		_quad(surface, a[0], b[0], b[1], a[1])
		_quad(surface, a[2], a[3], b[3], b[2])
		_quad(surface, a[0], a[2], b[2], b[0])
		_quad(surface, a[1], b[1], b[3], a[3])
	var first: Array = sections[0]
	var last: Array = sections[-1]
	_quad(surface, first[0], first[1], first[3], first[2])
	_quad(surface, last[0], last[2], last[3], last[1])
	surface.generate_normals()
	sheet_mesh.mesh = surface.commit()

func _quad(surface: SurfaceTool, a: Vector3, b: Vector3, c: Vector3, d: Vector3) -> void:
	for vertex: Vector3 in [a, b, c, a, c, d]:
		surface.add_vertex(vertex)
"

