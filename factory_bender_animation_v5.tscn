[sub_resource type="GDScript" id="Script_CellHMI"]
script/source = "extends Node

# Presentation-only connection simulation; no PLC/network transport is used.
var states: Array[String] = [\"CONNECTING\", \"CONNECTING\", \"CONNECTING\", \"CONNECTING\"]
var station_names: Array[String] = [\"LASER\", \"BENDER\", \"WELDER\", \"INSPECTION\"]
var elapsed: float = 0.0
var refresh_elapsed: float = 0.0
var latest_status: String = \"Establishing station connections...\"
var overlay: PanelContainer
var summary: Label
var message_label: Label
var card_labels: Array[Label] = []
var card_styles: Array[StyleBoxFlat] = []
var physical_label: Label3D
var lights: Array[MeshInstance3D] = []
var lamp_materials: Array[StandardMaterial3D] = []
@onready var robot: Node = $\"../RobotSystem\"
@onready var gate: Node = $\"../CellEnclosure/AccessGate\"
@onready var console: Node3D = $\"../HMIConsole\"

func _ready() -> void:
	for path: String in [\"../LaserCutter/HeartbeatLight\", \"../Bender/HeartbeatLight2\", \"../WeldCell/HeartbeatLight3\", \"../Inspection/HeartbeatLight4\"]:
		var light: MeshInstance3D = get_node(path) as MeshInstance3D
		var material: StandardMaterial3D = StandardMaterial3D.new()
		material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		light.material_override = material
		light.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		light.visible = true
		lights.append(light)
		lamp_materials.append(material)
	robot.connect(\"status_changed\", _on_robot_status)
	_build_hmi()
	_refresh()

func _build_hmi() -> void:
	var canvas: CanvasLayer = CanvasLayer.new()
	canvas.layer = 3
	add_child(canvas)
	overlay = PanelContainer.new()
	overlay.anchor_left = 1.0
	overlay.anchor_right = 1.0
	overlay.anchor_top = 1.0
	overlay.anchor_bottom = 1.0
	overlay.offset_left = -610.0
	overlay.offset_top = -245.0
	overlay.offset_right = -18.0
	overlay.offset_bottom = -18.0
	overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var background: StyleBoxFlat = StyleBoxFlat.new()
	background.bg_color = Color(0.025, 0.04, 0.065, 0.96)
	background.set_corner_radius_all(8)
	background.content_margin_left = 16.0
	background.content_margin_right = 16.0
	background.content_margin_top = 12.0
	background.content_margin_bottom = 12.0
	overlay.add_theme_stylebox_override(\"panel\", background)
	canvas.add_child(overlay)
	var column: VBoxContainer = VBoxContainer.new()
	column.mouse_filter = Control.MOUSE_FILTER_IGNORE
	column.add_theme_constant_override(\"separation\", 10)
	overlay.add_child(column)
	var heading: Label = Label.new()
	heading.text = \"CELL HMI  /  SIMULATED CONNECTIONS\"
	heading.add_theme_font_size_override(\"font_size\", 20)
	column.add_child(heading)
	summary = Label.new()
	column.add_child(summary)
	var row: HBoxContainer = HBoxContainer.new()
	row.add_theme_constant_override(\"separation\", 8)
	column.add_child(row)
	for i: int in range(4):
		var card: PanelContainer = PanelContainer.new()
		card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		card.mouse_filter = Control.MOUSE_FILTER_IGNORE
		var style: StyleBoxFlat = StyleBoxFlat.new()
		style.bg_color = Color(0.055, 0.075, 0.10)
		style.set_border_width_all(2)
		style.set_corner_radius_all(4)
		style.content_margin_left = 8.0
		style.content_margin_right = 8.0
		style.content_margin_top = 10.0
		style.content_margin_bottom = 10.0
		card.add_theme_stylebox_override(\"panel\", style)
		row.add_child(card)
		var label: Label = Label.new()
		label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		label.add_theme_font_size_override(\"font_size\", 14)
		card.add_child(label)
		card_labels.append(label)
		card_styles.append(style)
	message_label = Label.new()
	message_label.custom_minimum_size.x = 550.0
	message_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	column.add_child(message_label)
	var help: Label = Label.new()
	help.text = \"H: HMI  |  J: welder fault (idle)  |  R: reconnect  |  G: gate\"
	help.add_theme_font_size_override(\"font_size\", 13)
	help.modulate = Color(0.7, 0.76, 0.84)
	column.add_child(help)
	physical_label = Label3D.new()
	physical_label.name = \"LiveHMIDisplay\"
	physical_label.position = Vector3(0.0, 1.25, 0.385)
	physical_label.pixel_size = 0.00125
	physical_label.font_size = 25
	physical_label.outline_size = 3
	physical_label.modulate = Color(0.7, 0.95, 1.0)
	physical_label.shaded = false
	physical_label.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	console.add_child(physical_label)

func _process(delta: float) -> void:
	elapsed += delta
	refresh_elapsed += delta
	for i: int in range(4):
		if states[i] == \"CONNECTING\" and elapsed >= 1.5 + float(i) * 0.45:
			states[i] = \"READY\"
	if refresh_elapsed >= 0.15:
		refresh_elapsed = 0.0
		_refresh()

func _refresh() -> void:
	var rows: String = \"CELL CONTROL  /  SIMULATION\\n\"
	for i: int in range(4):
		var color: Color = Color(0.18, 0.95, 0.42)
		if states[i] == \"CONNECTING\":
			color = Color(1.0, 0.72, 0.09) * (0.6 + 0.4 * absf(sin(elapsed * 3.0)))
		elif states[i] == \"FAULT\":
			color = Color(1.0, 0.13, 0.16)
		elif states[i] == \"RUNNING\":
			color *= 1.0 if sin(elapsed * 10.0) > 0.0 else 0.3
		color.a = 1.0
		lamp_materials[i].albedo_color = color
		lights[i].visible = true
		card_styles[i].border_color = color
		card_labels[i].text = station_names[i] + \"\\n\" + states[i]
		rows += station_names[i] + \": \" + states[i] + \"\\n\"
	var gate_text: String = \"CLOSED\" if bool(gate.get(\"gate_closed\")) else \"OPEN\"
	if bool(gate.get(\"gate_moving\")):
		gate_text = \"MOVING\"
	var cycle: String = \"RUNNING\" if bool(robot.get(\"animation_running\")) else \"IDLE\"
	summary.text = \"PART %s   |   CYCLE: %s   |   GATE: %s\" % [str(robot.get(\"part_id\")), cycle, gate_text]
	message_label.text = latest_status
	rows += \"PART %s  |  GATE %s\" % [str(robot.get(\"part_id\")), gate_text]
	if physical_label.text != rows:
		physical_label.text = rows

func _on_robot_status(message: String) -> void:
	latest_status = message

func cycle_block_reason() -> String:
	for i: int in range(4):
		var required: bool = i == 0 or (i == 1 and bool(robot.get(\"use_bender\"))) or (i == 2 and bool(robot.get(\"use_welder\"))) or (i == 3 and bool(robot.get(\"use_inspection\")))
		if required and states[i] != \"READY\":
			return \"Start blocked: %s is %s.\" % [station_names[i], states[i].to_lower()]
	return \"\"

func begin_processing(station_name: String) -> void:
	var index: int = _station_index(station_name)
	if index >= 0:
		states[index] = \"RUNNING\"
	_refresh()

func end_processing(station_name: String) -> void:
	var index: int = _station_index(station_name)
	if index >= 0:
		states[index] = \"READY\"
	_refresh()

func _station_index(station_name: String) -> int:
	var normalized: String = station_name.to_upper()
	for i: int in range(4):
		if normalized.begins_with(station_names[i]):
			return i
	return -1

func _unhandled_input(event: InputEvent) -> void:
	if not (event is InputEventKey) or not event.pressed or event.echo:
		return
	if event.physical_keycode == KEY_H:
		overlay.visible = not overlay.visible
		get_viewport().set_input_as_handled()
	elif event.physical_keycode == KEY_J or event.physical_keycode == KEY_R:
		get_viewport().set_input_as_handled()
		if bool(robot.get(\"animation_running\")):
			latest_status = \"Wait for the cycle to finish before testing connection faults.\"
			return
		if event.physical_keycode == KEY_J:
			states[2] = \"FAULT\"
			latest_status = \"Welder connection timed out (simulated). Press R to reconnect.\"
		else:
			states.assign([\"CONNECTING\", \"CONNECTING\", \"CONNECTING\", \"CONNECTING\"])
			elapsed = 0.0
			latest_status = \"Reconnecting all stations...\"
		_refresh()
"

